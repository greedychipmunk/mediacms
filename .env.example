# Copy this file to .env and fill in the values. .env is gitignored and
# must never be committed.

# Tailscale auth key for the sidecar container.
# Generate one at https://login.tailscale.com/admin/settings/keys
# (a reusable, non-ephemeral key keeps the same device across restarts).
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# The URL at which the portal is reachable from your tailnet.
# The host name must match the `hostname:` of the `tailscale` service in
# docker-compose.yaml ("mediacms") plus your tailnet's name.
# Setting this to an https:// URL also enables Django's HTTPS awareness
# (CSRF trusted origins + X-Forwarded-Proto handling) automatically.
FRONTEND_HOST=https://mediacms.YOUR-TAILNET.ts.net
